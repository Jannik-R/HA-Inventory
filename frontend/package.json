{
  "name": "home-inventory-panel",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "test:e2e": "playwright test",
    "docs:screenshots": "playwright test -c playwright.docs.config.ts",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node scripts/check-expiry-parse.mjs",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "barcode-detector": "^3.2.3",
    "lit": "^3.3.3",
    "tesseract.js": "^7.0.0",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@tesseract.js-data/deu": "^1.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
